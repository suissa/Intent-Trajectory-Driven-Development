@delivery

D: delivery → requested paid assigned tracked delivered settled
I: customer → deliver
R: pickup + dropoff

B: request
→ collect
→ discover(courier*)
→ select(min distance)
→ charge
→ confirm
→ release
→ track*
→ validate(code)
→ settle

S: requested
→ collecting
→ recognizing
→ searching
→ assigned
→ awaiting_payment
→ paid
→ active
→ arriving
→ delivered
→ settled

A:
  customer { request address pay code }
  system { classify collect discover select charge validate route settle }
  courier { accept locate deliver }
  payment { confirm reject }

K select_courier {
  in: couriers + origin
  rule: min distance
  out: courier
  pre: addresses.collected
  post: courier.selected
  from: searching
  to: assigned
  emit: courier.selected
}

K request_delivery {
  in: pickup + dropoff
  rule: request delivery
  out: request
  from: requested
  to: collecting
  emit: request.received
}
K collect_addresses {
  in: pickup + dropoff
  rule: collect addresses
  out: addresses
  from: collecting
  to: recognizing
  pre: request.received
  emit: addresses.collected
}
K recognize_intent {
  in: request
  rule: classify intent
  out: intent
  from: recognizing
  to: searching
  pre: addresses.collected
  emit: intent.recognized
}
K select_courier {
  in: couriers + origin
  rule: min distance
  out: courier
  pre: addresses.collected
  post: courier.selected
  from: searching
  to: assigned
  emit: courier.selected
}
K confirm_payment {
  in: payment
  rule: confirm payment
  out: confirmation
  from: assigned
  to: awaiting_payment
  pre: courier.selected
  emit: payment.confirmed
}
K release_delivery {
  in: confirmation
  rule: release delivery
  out: delivery
  from: awaiting_payment
  to: paid
  pre: payment.confirmed
  emit: delivery.released
}
K track_delivery {
  in: location
  rule: forward location
  out: tracking
  from: paid
  to: active
  pre: delivery.released
  emit: location.received
}
K arrive_delivery {
  in: location
  rule: forward arrival
  out: arrival
  from: active
  to: arriving
  pre: location.received
  emit: location.forwarded
}
K validate_delivery {
  in: code
  rule: validate code
  out: validation
  from: arriving
  to: delivered
  pre: location.forwarded
  emit: code.validated
}
K settle_delivery {
  in: code + location
  rule: settle delivery
  out: settlement
  from: delivered
  to: settled
  pre: code.validated
  emit: settlement.completed
}

E: request.received
→ intent.recognized
→ addresses.collected
→ courier.selected
→ payment.confirmed
→ delivery.released
→ location.received*
→ location.forwarded*
→ code.validated
→ settlement.completed

X:
  ¬ release(payment ≠ confirmed)
  ¬ settle(code ≠ valid)
  ¬ settle(location ≠ dropoff)
  ¬ select(courier ∉ available)

T: request.received
→ intent.recognized
→ addresses.collected
→ courier.selected
→ payment.confirmed
→ delivery.released
→ location.received*
→ location.forwarded*
→ code.validated
→ settlement.completed
